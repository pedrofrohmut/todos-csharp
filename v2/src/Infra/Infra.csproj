<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <PackageReference Include="jose-jwt" Version="5.3.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.2" />
    <PackageReference Include="Npgsql" Version="10.0.2" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.1.0" />
    <PackageReference Include="Dapper" Version="2.1.72" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>

    <ImplicitUsings>enable</ImplicitUsings>

    <Nullable>enable</Nullable>

    <!--
        WarningsAsErrors: Treat specific warnings as build errors

        0219 = CS0219: Variable assigned but never used
        CS0168 = CS0168: Variable declared but never used
        nullable = All nullability warnings (CS8600, CS8625, etc.)
        CS8509 = Switch expression doesn't handle all possible values

        This prevents Option<string>.Some(null) from compiling
        by turning the nullability warning into an error.
    -->
    <WarningsAsErrors>0219;CS0168;nullable;CS8509;</WarningsAsErrors>
  </PropertyGroup>

</Project>
